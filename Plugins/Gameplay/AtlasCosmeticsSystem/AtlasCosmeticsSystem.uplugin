{
  "FileVersion": 3,
  "Version": 1,
  "VersionName": "1.0",
  "FriendlyName": "Atlas Cosmetics System",
  "Description": "Project-neutral replicated appearance composition and cosmetic presentation runtime.",
  "Category": "Gameplay",
  "CreatedBy": "Callback Games",
  "CreatedByURL": "https://callbackgames.com/",
  "EnabledByDefault": true,
  "CanContainContent": false,
  "IsBetaVersion": false,
  "IsExperimentalVersion": false,
  "Installed": true,
  "Plugins": [
    {
      "Name": "GameFeatures",
      "Enabled": true
    },
    {
      "Name": "AtlasGameFeaturesFramework",
      "Enabled": true
    },
    {
      "Name": "AtlasGameplayActorsFramework",
      "Enabled": true
    },
    {
      "Name": "ModularGameplay",
      "Enabled": true
    },
    {
      "Name": "Niagara",
      "Enabled": true
    },
    {
      "Name": "CommonUI",
      "Enabled": true
    }
  ],
  "Modules": [
    {
      "Name": "AtlasCosmeticsSystemRuntime",
      "Type": "Runtime",
      "LoadingPhase": "Default"
    },
    {
      "Name": "AtlasCosmeticsSystemEditor",
      "Type": "Editor",
      "LoadingPhase": "Default"
    },
    {
      "Name": "AtlasCosmeticsSystemUI",
      "Type": "Runtime",
      "LoadingPhase": "Default"
    }
  ],
  "AtlasModTemplates": {
    "SchemaVersion": 1,
    "Templates": [
      {
        "Id": "AtlasCosmeticsSystem.Cosmetic",
        "BaseTemplate": "CosmeticPack",
        "Category": "Cosmetics & UI",
        "Label": "Mod cosmetic",
        "Description": "Start with a cosmetic Blueprint and a Cosmetic Definition. Add Mod Cosmetics is already set up. No inventory item or crafting recipe is needed.",
        "Recipe": "Documentation/Examples/CreateCosmeticModExample.py",
        "RequiredPlugins": [
          "AtlasCosmeticsSystem"
        ],
        "AssetPaths": [
          "CosmeticExample/BP_ExampleCosmetic",
          "CosmeticExample/DA_ExampleCosmetic"
        ],
        "NextSteps": [
          "Replace the marker under BP_ExampleCosmetic.WorldView with your own mesh. Keep collision disabled and fit the attachment socket/offset to your character.",
          "Edit the name and slot in DA_ExampleCosmetic. In KLETKA, use the Head or Body slot used by the wardrobe.",
          "Compile and save. Cook the mod in Release → Cook & Publish, install the test copy, and enable it in game. Select it in the matching wardrobe tab."
        ]
      }
    ]
  }
}
